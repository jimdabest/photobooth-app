{
  "name": "photobooth-app",
  "version": "0.1.0",
  "homepage": ".",
  "main": "public/electron.js",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "deploy:pages": "npx wrangler pages deploy build --project-name simplex-photobooth",
    "electron:start": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "build:backend": "backend\\venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean --onedir --name photobooth-backend --distpath backend\\bundle --workpath backend\\.pyinstaller-work --specpath backend\\.pyinstaller-spec --add-binary \"..\\EDSDK.dll;.\" --add-binary \"..\\EdsImage.dll;.\" --collect-all PIL backend\\run.py",
    "dist:win": "npm run build && npm run build:backend && electron-builder --win nsis",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-scripts": "5.0.1",
    "wait-on": "^9.1.0",
    "web-vitals": "^2.1.4"
  },
  "build": {
    "extends": null,
    "appId": "com.simplex.photobooth",
    "productName": "Simplex Photobooth",
    "asar": true,
    "extraMetadata": {
      "dependencies": {}
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/bundle/photobooth-backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "backend/.env.example",
        "to": "backend/.env.example"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
